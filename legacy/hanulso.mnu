<?xml version="1.0" encoding="utf-8"?>
<hanulso>
	<!-- [LOG: 20260407] 원본 PC통신 메뉴 구조 기반 확장 -->
	<item type="menu" text="txt/top.txt" go="top">
		<name>PC통신동호회 01410</name>
		<header>txt/header.txt</header>
		<footer>txt/cmd_top_footer.txt</footer>

		<!-- 01. 서비스안내 -->
		<item type="menu" go="guide" door="1">
			<name>서비스안내 (GUIDE)</name>
			<footer>txt/cmd_menu_footer.txt</footer>

			<item type="board" go="notice" id="bbs_notice" door="1" access_level="1">
				<name>공지사항</name>
				<attachment>yes</attachment>
				<write_sysop_only>yes</write_sysop_only>
				<reply>no</reply>
				<header>txt/header.txt</header>
				<footer></footer>
			</item>

			<item type="board" go="tosysop" id="bbs_suggest" door="2" access_level="1">
				<name>건의하기</name>
				<attachment>yes</attachment>
				<reply>yes</reply>
				<header></header>
				<footer></footer>
			</item>

			<!-- [LOG_ID: 20260713_2300] 사용자 지적으로 자료실/개인영역/전자우편/대화실/온라인오락실
			     바로가기 5개를 제거했다 — 나우누리 원전은 TOP이 3단 배치라 GUIDE 요약 인덱스가
			     의미 있었지만, 이 앱은 TOP이 1열로 전부 노출되는 구조라 GUIDE의 이 항목들은
			     TOP 3/4/6/8/9번과 완전히 동일한 화면으로 가는 순수 중복 바로가기였다(20260713_2030
			     당시 원전을 기계적으로 베끼며 이 앱 맥락에서의 실효성을 안 따진 실수). 명령어안내/
			     이용약관/개인정보처리방침 3개만 남긴다 — 이건 TOP에 없는 진짜 신규 기능이다. -->
			<!-- [LOG_ID: 20260714_1300] go값을 guide_* 접두 스네이크케이스에서 짧은 코드로 정정
			     (id는 그대로 유지해 트리 내 고유성 확보) — getMenuNodeCode()가 이 go값을
			     그대로 대문자화해 "(코드)" 형태로 화면에 노출하는데, 예전 값은
			     "(GUIDE_CMDHELP)" 처럼 볼썽사납게 나왔었다. -->
			<!-- [LOG_ID: 20260715_0900] go값을 cmdhelp -> help로 정정 — 이 항목은 전역 H/HELP
			     명령과 동일한 화면(showHelp)으로 연결되므로, "(CMDHELP)"라는 실재하지 않는
			     명령 코드보다 실제 명령어와 일치하는 "(HELP)"가 맞다(사용자 지적). -->
			<item type="help" go="help" id="guide_cmdhelp" door="3" access_level="1">
				<name>명령어안내</name>
			</item>

			<item type="policy" go="tos" id="guide_tos" target="tos" door="4" access_level="1">
				<name>이용약관</name>
			</item>

			<item type="policy" go="privacy" id="guide_privacy" target="privacy" door="5" access_level="1">
				<name>개인정보처리방침</name>
			</item>

			<!-- [LOG_ID: 20260716_1400] 하이텔 원전 (1)서비스안내-[회원정보]-24.이용자검색(member)
			     -1.이용자 ID(byid) -2.이용자 이름(byname). 서버 API(/api/members/search)와 프로필
			     화면(showProfile)이 이미 있는데 진입 화면만 없어서, 아이디를 정확히 아는 사람만
			     PF/WHO 명령으로 프로필을 볼 수 있었다(닉네임 검색은 아예 불가). 빈 껍데기가 아니라
			     이미 있는 데이터·API를 노출하는 화면이라 추가한다. -->
			<item type="member-search" go="member" id="guide_member" door="6" access_level="1">
				<name>이용자검색</name>
			</item>

			<!-- [LOG_ID: 20260716_1600] 하이텔 원전 (1)서비스안내-6.메뉴안내(menu)/8.인덱스안내(index).
			     GO 명령은 있는데 쓸 수 있는 키워드를 한눈에 볼 화면이 없었다 — TOP엔 11개만 보이고
			     나머지 19개는 서브메뉴 4곳을 일일이 들어가야 보인다. 살아있는 메뉴 트리에서 매번
			     생성하므로 낡거나 비지 않는다(별도 데이터·API 없음). -->
			<item type="menu-index" go="index" id="guide_index" door="7" access_level="1">
				<name>전체 메뉴 안내</name>
			</item>

			<!-- [LOG_ID: 20260716_2200] 하이텔 원전 (1)서비스안내-[회원정보]-25.접속통계(account).
			     원전은 접속 횟수·사용 시간·요금을 보여줬지만 이 앱은 세션을 기록하지 않아 그 수치는
			     만들 수 없다. 없는 값을 지어내는 대신 이미 가진 데이터(가입일·최근접속·등급·글/조회/
			     추천·쪽지)로 "이용 현황"을 낸다. -->
			<item type="my-stats" go="account" id="guide_account" door="8" access_level="1">
				<name>이용 현황</name>
			</item>
		</item>

