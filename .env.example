# Copy to .env for local development. Never put real secrets in this file.
BOARD_REPOSITORY_DRIVER=supabase
CHAT_ROOM_REPOSITORY_DRIVER=supabase
ACTIVITY_REPOSITORY_DRIVER=supabase

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_ANON_KEY=<anon-key>
# Required by every server-side repository. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_BOARDS_TABLE=boards
SUPABASE_POSTS_TABLE=posts
SUPABASE_MEMBERS_TABLE=members
SUPABASE_MEMOS_TABLE=memos
SUPABASE_ATTACHMENTS_TABLE=attachments
SUPABASE_CHAT_ROOMS_TABLE=chat_rooms
SUPABASE_CHAT_ROOM_MEMBERS_TABLE=chat_room_members
SUPABASE_RECOMMENDATIONS_TABLE=post_recommendations
SUPABASE_ACTIVITY_TABLE=user_activities

RSS_CACHE_DRIVER=supabase
RSS_CACHE_TABLE=rss_cache

# Development: localhost only. The deployed service uses only this HTTPS origin;
# set the same value in Vercel Production (do not use the Vercel owner/project slug).
# BBS_ALLOWED_ORIGINS=https://01410.vercel.app
BBS_ALLOWED_ORIGINS=http://localhost:3000

RESEND_API_KEY=<resend-api-key>
SYSOP_EMAIL=sysop@example.com
# resend.dev is testing-only and only permits the Resend account email.
# Use a verified domain for production recipients.
SYSOP_MAIL_FROM=onboarding@resend.dev
