{
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "legacy/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/password",
      "destination": "/index.html"
    },
    {
      "source": "/log",
      "destination": "/index.html"
    },
    {
      "source": "/guide",
      "destination": "/index.html"
    },
    {
      "source": "/bbs",
      "destination": "/index.html"
    },
    {
      "source": "/pds",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/signup/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/sub/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/board/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/chat/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/service/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/help",
      "destination": "/index.html"
    },
    {
      "source": "/profile/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/myinfo",
      "destination": "/index.html"
    },
    {
      "source": "/memo",
      "destination": "/index.html"
    },
    {
      "source": "/memo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/menu/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}